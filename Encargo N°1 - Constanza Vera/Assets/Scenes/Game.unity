  m_Script: {fileID: 11500000, guid: c086147714c5b034ba4ad80d88034a65, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  component: {fileID: 1463990877}
  lines:
  - "Jessica:  \xA1Me ten\xEDas preocupada! Ayer dejaste de responder"
  - "Perd\xF3n. Me tom\xE9 una pastilla para dormir\u2026 "
  - 'Jessica: Tienes que tener cuidado con esas cosas'
  - "Jessica: \xBFHas visto a tu terapeuta?"
  - "Vengo de all\xE1"
  - "Jessica: \xBFQu\xE9 te dice?"
  - "Tengo que dejar de preocuparme por estupideces e intentar recuperar mi vida\u2026 "
  - "Jessica: \xBFY con eso est\xE1s bien?"
  - "Supongo\u2026 De alguna manera solo piensa que estoy loca."
  - 'Jessica: No lo estas. Tal vez tienes que buscar otro terapeuta'
  - "Tal vez\u2026 "
  - Tengo que cortar
  - "Jessica: Esta bien. Cuidate\u2026"
  - '[Llamada finalizada]'
  - "Necesito un caf\xE9\u2026  "
  textSpeed: 0.1
  phoneSystem: {fileID: 1861115302}
  skipButton: {fileID: 0}
