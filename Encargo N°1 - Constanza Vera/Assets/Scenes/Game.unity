  m_Script: {fileID: 11500000, guid: b04e432719acb7c4ea99376fa3741ac6, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  llamadas:
  - nombre: Jessica
    imagenContacto: {fileID: 0}
    tiempoInicio: 20
    panelLlamada: {fileID: 1643650961}
    panelEnLlamada: {fileID: 1449589724}
    duracionMaxima: 20
    audioAndSubtitles: {fileID: 11400000, guid: b46cf4214cbb7e84dbbd94235acddaa3, type: 2}
  imagenContactoUI: {fileID: 0}
  textoDuracionLlamada: {fileID: 486941020}
  botonContestar: {fileID: 42870505}
  botonCortar: {fileID: 1919125126}
  botonCortarEnLlamada: {fileID: 1666329491}
  audioLlamada: {fileID: 697909026}
  clipLlamada: {fileID: 8300000, guid: 3eb962215283f374295c20c953663dd2, type: 3}
  audioConversacion: {fileID: 697909028}
  audioSource: {fileID: 1566564356}
  Touch: {fileID: 8300000, guid: 95893029919a89d43b80e3f3c662699b, type: 3}
  imagenAVibrar: {fileID: 1643650964}
  intensidadVibracion: 1
  frecuenciaVibracion: 10
  notificacionLlamadaUI: {fileID: 358356543}
  notificacionPostLlamadaUI: {fileID: 1470036460}
  audioNegacion: {fileID: 8300000, guid: d1490fce34bb8cd4e821dd904d0fa11a, type: 3}
  audioUI: {fileID: 697909027}
  subtitulos:
  - texto: "Jessica: Me ten\xEDas preocupada \xA1Ayer dejaste de responder!"
    delayAntes: 0.2
    duracion: 3
  - texto: "Isabel: Perd\xF3n..."
    delayAntes: 3.1
    duracion: 1
  - texto: "Isabel: Me tom\xE9 una pastilla para dormir y..."
    delayAntes: 2.3
    duracion: 2
  - texto: 'Isabel: Ah...'
    delayAntes: 1.8
    duracion: 1.3
  - texto: 'Jessica: Ay... Tienes que tener cuidado con esas cosas'
    delayAntes: 2
    duracion: 1.9
  - texto: "Jessica: \xBFHaz visto a tu terapeuta?"
    delayAntes: 2.3
    duracion: 1.5
  - texto: "Isabel: Ajam... Vengo de all\xE1"
    delayAntes: 1.8
    duracion: 2
  - texto: "Jessica: \xBFQu\xE9 te dice?"
    delayAntes: 2
    duracion: 0.8
  - texto: 'Isabel: Que tengo que dejar de preocuparme por estupideces'
    delayAntes: 1.8
    duracion: 2.3
  - texto: 'Isabel: E intentar... Recuperar mi vida'
    delayAntes: 1.8
    duracion: 3.5
  - texto: "Jessica: \xBFY con eso est\xE1s bien?"
    delayAntes: 3.5
    duracion: 2
  - texto: 'Isabel: Supongo...'
    delayAntes: 2
    duracion: 1.8
  - texto: 'Isabel: De alguna manera solo piensa que estoy loca'
    delayAntes: 1.8
    duracion: 4
  - texto: "Jessica: No lo est\xE1s..."
    delayAntes: 4
    duracion: 2
  - texto: 'Jessica: Tal vez tienes que buscar otro terapeuta'
    delayAntes: 2
    duracion: 3
  - texto: 'Isabel: Tal vez...'
    delayAntes: 3
    duracion: 2
  - texto: 'Isabel: Bueno, tengo que cortar'
    delayAntes: 2
    duracion: 3
  - texto: "Jessica: Esta bien, \xA1Cuidate!"
    delayAntes: 2
    duracion: 3
